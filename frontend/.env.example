# frontend/.env
# ==========================================
# FRONTEND SERVER CONFIGURATION (Local Development)
# ==========================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
VITE_APP_ENV=development

# ==========================================
# CASE 1: Target Docker Stack / Nginx Reverse Proxy [DEFAULT]
# ==========================================
# - SSR (Node.js runtime) calls via Nginx proxy on port 8080:
API_BASE_URL=http://localhost:8080
# - Browser Client calls via Nginx proxy on port 8080:
VITE_API_BASE_URL=http://localhost:8080

# ==========================================
# CASE 2: Target Standalone Local Backend (npm run dev without Nginx)
# ==========================================
# - SSR (Node.js runtime) calls local backend directly on port 3002:
# API_BASE_URL=http://127.0.0.1:3002
# - Browser Client calls local backend directly on port 3002 (requires CORS enabled):
# VITE_API_BASE_URL=http://localhost:3002