{
  "name": "vimes-inventory-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Backend API for Goods Receipt Management (Mẫu 01 - VT)",
  "repository": {
    "type": "git",
    "url": "git@github.com:KotonoSora/interview-vimes.git"
  },
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/app.ts",
    "lint": "tsc --noEmit",
    "lint:commitlint": "commitlint --edit",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "prettier": "prettier",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "morgan": "1.11.0",
    "pg": "8.23.0",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/hpp": "0.2.7",
    "@types/morgan": "1.9.10",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.19.0"
  }
}
