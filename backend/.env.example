# backend/.env
# ==========================================
# SERVER CONFIGURATION (Local Development)
# ==========================================
PORT=3002
HOST=0.0.0.0
NODE_ENV=development

# ==========================================
# E2E TESTING TARGET URL
# ==========================================
# CASE 1: Test against Docker Stack (via Nginx Reverse Proxy) [DEFAULT]
API_BASE_URL=http://localhost:8080/api/v1

# CASE 2: Test directly against standalone Local Backend (without Nginx)
# API_BASE_URL=http://localhost:3002/api/v1

# ==========================================
# DATABASE CONNECTION
# ==========================================
# Superuser connection for migrations/dev setup
# DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/vimes_inventory

# Least-privilege application user connection
DATABASE_URL=postgresql://app_user:app_secure_password_2026@localhost:5432/vimes_inventory